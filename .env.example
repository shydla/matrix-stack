# =============================================================================
#  .env для Matrix-стека.  Скопируйте в .env и заполните.
#  Секреты (значения "CHANGEME_*") заменяются автоматически:
#      ./scripts/generate-env.sh
#  После этого руками нужно проверить только домен и, при желании, почту.
# =============================================================================

# --- Домен и публичный адрес ------------------------------------------------
# Домен сервера (часть MXID после двоеточия). ДОЛЖЕН резолвиться в этот хост.
SERVER_NAME=example.com
# Публичный адрес (со схемой, без слэша на конце). При внешнем TLS — https.
PUBLIC_BASE_URL=https://example.com

# --- Порты на хосте ---------------------------------------------------------
# 80 = обычный вход (перед ним обычно внешний прокси с TLS).
HTTP_PORT=80
# На каком интерфейсе публиковать порты (0.0.0.0 = все).
HTTP_BIND=0.0.0.0
# Диапазон UDP-портов LiveKit для медиа (профиль calls).
# ВАЖНО: если NODE_IP не задан (внешний адрес определяется автоматически),
# диапазон должен быть шире одного порта — иначе LiveKit падает в панику.
# Один порт (например 7882/7882) допустим только при заполненном NODE_IP.
RTC_RANGE_START=7882
RTC_RANGE_END=7892

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_SUPERUSER=matrix
POSTGRES_SUPERUSER_PASSWORD=CHANGEME_POSTGRES_SUPERUSER_PASSWORD

SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_USER=synapse_user
SYNAPSE_DB_PASSWORD=CHANGEME_SYNAPSE_DB_PASSWORD

MAS_DB_NAME=mas
MAS_DB_USER=mas_user
MAS_DB_PASSWORD=CHANGEME_MAS_DB_PASSWORD

# --- Секреты Synapse (генерируются) -----------------------------------------
SYNAPSE_MACAROON_SECRET_KEY=CHANGEME_SYNAPSE_MACAROON
SYNAPSE_REGISTRATION_SHARED_SECRET=CHANGEME_SYNAPSE_REG_SHARED
# Общий секрет Synapse <-> MAS. ОБЯЗАН совпадать в обоих конфигах.
MAS_MATRIX_SECRET=CHANGEME_MAS_MATRIX_SECRET

# --- Администратор ----------------------------------------------------------
# Локальная часть MXID администратора (для admin API и панели).
ADMIN_USER=admin

# --- Регистрация ------------------------------------------------------------
# true  = для регистрации нужен одноразовый токен (безопасно для публичного сервера)
# false = любой может зарегистрироваться (только для закрытого теста)
REGISTRATION_TOKEN_REQUIRED=true
# Идентификатор OIDC-клиента для веб-клиента (Element Web) и мобильных.
OIDC_CLIENT_ID=CHANGEME_OIDC_CLIENT_ID

# --- Почта (для писем MAS: подтверждение адреса, сброс пароля) --------------
# false = секция email в конфиг MAS не попадёт вообще.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_MODE=tls
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
EMAIL_FROM='"Matrix Authentication" <no-reply@example.com>'

# --- Звонки (профиль calls) -------------------------------------------------
# true = в конфиги попадут блоки для звонков (matrix_rtc, RTC focus в well-known).
# Поднимать сам стек:  docker compose --profile calls up -d
ENABLE_CALLS=false
LIVEKIT_KEY=CHANGEME_LIVEKIT_KEY
LIVEKIT_SECRET=CHANGEME_LIVEKIT_SECRET
# Публичный IP этого хоста. Пусто = LiveKit определит внешний IP сам (STUN).
# Указывать обязательно, если сервер за NAT/прокси или IP-адрес не определяется.
NODE_IP=
# TURN через этот же домен (порт 3478/udp и 5349/tcp).
TURN_ENABLED=false
# true = TLS для TURN терминирует ВНЕШНИЙ прокси (нужен валидный сертификат).
TURN_EXTERNAL_TLS=true
# UDP-порт TURN на хосте (если 3478 уже занят другим TURN/сервисом)
TURN_UDP_PORT=3478
# TCP-порт TURN/TLS на хосте
TURN_TLS_PORT=5349
# Клиентские креденшелы TURN для well-known (если TURN_ENABLED=true).
TURN_USERNAME=turn
TURN_CREDENTIAL=

# --- Версии образов (меняйте осознанно) -------------------------------------
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.162.0
MAS_IMAGE=ghcr.io/element-hq/matrix-authentication-service:1.26.0
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.9
# lk-jwt-service v0.7.0: v0.8.0 меняет формат /get_token (ломает старые клиенты)
LKJWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:0.7.0
