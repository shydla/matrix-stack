# =============================================================================
#  LiveKit SFU — config.yaml (профиль "calls")
#  Сгенерировано из templates/livekit.yaml.tmpl
# =============================================================================

port: 7880

rtc:
  # UDP-порты медиа. Диапазон ОБЯЗАН быть шире одного порта, если внешний IP
  # определяется автоматически (use_external_ip: true): LiveKit выбирает
  # случайный порт из диапазона и на range из одного порта падает в панику
  # (rand.Intn(0)). Один порт допустим только при заданном NODE_IP.
  port_range_start: ${RTC_RANGE_START}
  port_range_end: ${RTC_RANGE_END}
  # ICE по TCP (для сетей, где UDP закрыт)
  tcp_port: 7881
  # STUN-серверы для определения внешнего адреса.
  # ВАЖНО: при use_external_ip: true список обязан быть непустым — иначе LiveKit
  # падает в панику (`rand.Intn(0)`) ещё до старта.
  stun_servers:
    - stun.l.google.com:19302
    - stun.cloudflare.com:3478
  # --- адресация: раскомментируется render.py при заполненном NODE_IP ---
  #__NODE_IP_LINES__

keys:
  ${LIVEKIT_KEY}: ${LIVEKIT_SECRET}

room:
  auto_create: false

turn:
  enabled: ${TURN_ENABLED}
  udp_port: 3478
  tls_port: 5349
  # true = TLS терминирует ВНЕШНИЙ прокси (нужен сертификат на домен TURN).
  # false = LiveKit отдаёт самоподписанный сертификат (клиенты будут ругаться).
  external_tls: ${TURN_EXTERNAL_TLS}
  domain: ${SERVER_NAME}

logging:
  level: info
  json: false
